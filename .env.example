PORT=3000
# Token rahasia untuk login dashboard. WAJIB diisi — tanpa ini halaman /login menolak semua upaya masuk.
# Buat token acak yang kuat, mis: openssl rand -hex 32
DASH_TOKEN=

# Kunci API Gemini untuk live chat agent (/api/agents/:id/chat/live)
GEMINI_API_KEY=

# ===== OAuth2 akun sosial (opsional — isi per platform yang mau dihubungkan beneran) =====
# URL publik dashboard, mis: https://dashboard.milikmu.com (tanpa trailing slash).
# redirect_uri tiap provider = OAUTH_REDIRECT_BASE + /api/social/oauth/<id>/callback
# Daftarkan URL itu di pengaturan aplikasi OAuth masing-masing platform.
OAUTH_REDIRECT_BASE=

# Google & YouTube (satu kredensial Google Cloud untuk keduanya)
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_YOUTUBE_CLIENT_ID=
OAUTH_YOUTUBE_CLIENT_SECRET=

# Meta (Facebook & Instagram via Facebook Login)
OAUTH_FACEBOOK_CLIENT_ID=
OAUTH_FACEBOOK_CLIENT_SECRET=
OAUTH_INSTAGRAM_CLIENT_ID=
OAUTH_INSTAGRAM_CLIENT_SECRET=

# TikTok, Upwork, GitHub
OAUTH_TIKTOK_CLIENT_ID=
OAUTH_TIKTOK_CLIENT_SECRET=
OAUTH_UPWORK_CLIENT_ID=
OAUTH_UPWORK_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
